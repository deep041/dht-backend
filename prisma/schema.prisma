generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model roles {
  role_name String @db.VarChar
  id        Int    @id @default(autoincrement())

  users     Users[]
}

enum MenuStatus {
  active
  inactive
}

model menus {
  id              Int        @id @default(autoincrement())
  menu_name       String     @db.VarChar(100)
  menu_url        String?    @db.VarChar(255)
  icon_name       String?    @db.VarChar(100)
  parent_menu_id  Int?
  status          MenuStatus @default(active)
  sequence        Int        @default(0)

  parent   menus?  @relation("MenuToSubMenu", fields: [parent_menu_id], references: [id])
  children menus[] @relation("MenuToSubMenu")

  @@index([parent_menu_id])
}

enum RegionStatus {
  active
  inactive
}

model Region {
  id          Int          @id @default(autoincrement())
  region_name String       @unique
  status      RegionStatus @default(active)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  zones       Zone[]
  subZones    SubZone[]
  users       Users[]
}

model Zone {
  id         Int          @id @default(autoincrement())
  zone       String
  regionId   Int
  region     Region       @relation(fields: [regionId], references: [id])
  status     ZoneStatus   @default(active)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  subZones   SubZone[]
  users      Users[]

  @@map("zones")
}

enum ZoneStatus {
  active
  inactive
}

model SubZone {
  id            Int            @id @default(autoincrement())
  subZoneTitle  String
  zoneId        Int
  regionId      Int
  status        SubZoneStatus  @default(active)

  zone          Zone           @relation(fields: [zoneId], references: [id])
  region        Region         @relation(fields: [regionId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  users         Users[]

  @@map("sub_zones")
}

enum SubZoneStatus {
  active
  inactive
}

model Department {
  id            Int            @id @default(autoincrement())
  code          String
  name          String

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  users             Users[]
  purchaseIndents   PurchaseIndent[]
}

model Country {
  id            Int            @id @default(autoincrement())
  code          String
  name          String

  states            State[]
  plantUnits        PlantUnit[]
  companyDetails    CompanyDetails[]
  suppliers         Supplier[]
  customerAddress   CustomerAddress[]
}

model State {
  id            Int            @id @default(autoincrement())
  country_id    Int           
  code          String
  name          String

  country        Country @relation(fields: [country_id], references: [id])

  plantUnits        PlantUnit[]
  companyDetails    CompanyDetails[]
  suppliers         Supplier[]
  customerAddress   CustomerAddress[]
}

model PlantUnit {
  id              Int            @id @default(autoincrement())
  unit_name       String
  company_name    String
  address_line_1  String
  address_line_2  String
  place           String
  stateId         Int
  countryId       Int
  state_code      Int
  pin_code        Int
  gst_no          String
  pan_no          String
  cin_no          String
  contact_no      String
  email_id        String

  country         Country        @relation(fields: [countryId], references: [id])
  state           State          @relation(fields: [stateId], references: [id])
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  warehouses      Warehouses[]
  salesOrders     SalesOrder[]
  taxInvoices     TaxInvoice[]
  purchaseIndents PurchaseIndent[]
}

model Warehouses {
  id              Int            @id @default(autoincrement())
  name            String
  description     String
  plant_unit_id   Int

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  plantUnit       PlantUnit      @relation(fields: [plant_unit_id], references: [id])
  taxInvoices     TaxInvoice[]
}

model PartyGroups {
  id              Int            @id @default(autoincrement())
  name            String

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  suppliers       Supplier[]
}

model BankAccounts {
  id              Int            @id @default(autoincrement())
  account_number  String
  bank_name       String
  ifsc_code       String
  branch_name     String
  branch_code     String
  micr_code       String
  bank_address    String
  account_name    String
  details         String
  opening_balance Float
  credit_or_debit String

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  quotations      Quotation[]
  taxInvoices     TaxInvoice[]
}

model PaymentTerms {
  id              Int            @id @default(autoincrement())
  term_name       String

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  suppliers       Supplier[]
  quotations      Quotation[]
  salesOrders     SalesOrder[]
  taxInvoices     TaxInvoice[]
}

model CompanyDetails {
  id                        Int            @id @default(autoincrement())
  company_name              String
  company_short_name        String
  proprietor                String
  phone                     String
  phone_2                   String
  email_id                  String
  email_id_2                String
  country_id                Int
  state_id                  Int
  pin_code                  Int
  place                     String
  state_code                Int
  address_line_1            String
  address_line_2            String
  gst_applicable            Boolean
  gst_no                    String
  pan_no                    String
  cin_no                    String
  llpin_no                  String
  website                   String
  logo                      String

  asp_id                    Int
  asp_password              String
  portal_client_user_name   String
  portal_client_password    String

  country                   Country         @relation(fields: [country_id], references: [id])
  state                     State           @relation(fields: [state_id], references: [id])

  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
}

model Users {
  id              Int            @id @default(autoincrement())
  first_name      String
  last_name       String
  username        String         @unique
  contact_no      String
  email           String         @unique
  department_id   Int
  role_id         Int
  reporting_to    Int?

  region_id       Int?
  zone_id         Int?
  sub_zone_id     Int?
  password        String
  profile_picture String?
  is_auth_person  Boolean        @default(false)

  role            roles          @relation(fields: [role_id], references: [id])
  department      Department     @relation(fields: [department_id], references: [id])
  region          Region?        @relation(fields: [region_id], references: [id])
  zone            Zone?          @relation(fields: [zone_id], references: [id])
  sub_zone        SubZone?       @relation(fields: [sub_zone_id], references: [id])

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Supplier {
  id                    Int       @id @default(autoincrement())

  partyGroupId          Int
  PartyGroups           PartyGroups @relation(fields: [partyGroupId], references: [id])

  companyName           String
  legalName             String?
  gstNo                 String?
  panNo                 String?

  typeOfConcern         TypeOfConcern
  gstRegistrationType   GstRegistrationType

  vendorCode            String?
  contactNo             String?
  email                 String?

  addressLine1          String?
  place                 String?
  pinCode               String?

  countryId             Int
  country               Country @relation(fields: [countryId], references: [id])

  stateId               Int
  state                 State @relation(fields: [stateId], references: [id])

  stateCode             String?

  website               String?

  creditPeriodDays      Int?
  creditLimit           Float?

  paymentTermId         Int?
  paymentTerms          PaymentTerms? @relation(fields: [paymentTermId], references: [id])

  note                  String?

  openingAmount         Float?
  balanceType           BalanceType? // Cr/Dr

  contactPersons        SupplierContactPerson[]
  bankAccounts          SupplierBankAccount[]
  purchaseIndentLines   PurchaseIndentLineItem[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model SupplierContactPerson {
  id            Int      @id @default(autoincrement())

  supplierId    Int
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  name          String
  mobileNo      String?
  email         String?
  designation   String?

  createdAt     DateTime @default(now())
}

model SupplierBankAccount {
  id            Int      @id @default(autoincrement())

  supplierId    Int
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  bankName      String
  accountNo     String
  accountType   AccountType

  branchCode    String?
  branchName    String?
  branchAddress String?

  ifscCode      String?
  swiftCode     String?

  createdAt     DateTime @default(now())
}

enum TypeOfConcern {
  PROPRIETORY
  PARTNERSHIP
  PVT_LTD
  LTD
}

enum GstRegistrationType {
  REGULAR
  UNREGISTERED
  COMPOSITION
  CONSUMER
}

enum AccountType {
  CURRENT
  SAVING
}

enum BalanceType {
  CREDIT
  DEBIT
}

model Customer {
  id                Int      @id @default(autoincrement())

  supplyType        String?   // B2B, B2C
  partyGroupId      Int
  companyName       String
  legalName         String?
  panNo             String?
  contactNo         String?
  email             String?

  vendorCode        String?
  creditPeriodDays  Int?
  creditLimit       Float?
  paymentTermId     Int?
  note              String?

  addresses         CustomerAddress[]
  contactPersons    CustomerContactPerson[]
  quotations        Quotation[]
  salesOrders       SalesOrder[]
  taxInvoices       TaxInvoice[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model CustomerAddress {
  id          Int    @id @default(autoincrement())

  customerId  Int
  type        AddressType // BILLING / SHIPPING

  attentionName String?
  gstNo       String?
  addressLine String
  place       String
  pinCode     String

  countryId   Int
  country     Country @relation(fields: [countryId], references: [id])

  stateId     Int
  state       State @relation(fields: [stateId], references: [id])
  stateCode   String

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  salesOrders SalesOrder[]
  taxInvoices TaxInvoice[]
}

model CustomerContactPerson {
  id          Int    @id @default(autoincrement())

  customerId  Int
  name        String
  mobileNo    String?
  email       String?
  designation String?

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  quotations  Quotation[]
  salesOrders SalesOrder[]
  taxInvoices TaxInvoice[]
}

enum AddressType {
  BILLING
  SHIPPING
}

model HsnMaster {
  id          Int      @id @default(autoincrement())
  hsnCode     String   @unique   // keep as string (some codes can be long)
  gstSlab     Int      // 0, 5, 12, 18, 28
  description String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rawMaterial RawMaterial[]
}

model Account {
  id    Int    @id @default(autoincrement())
  code  String @unique
  name  String

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  classifications   Classification[]
}

model Classification {
  id               Int      @id @default(autoincrement())

  isUsedInItemName Boolean  @default(false)
  name             String
  shortName        String
  accountId        Int

  account          Account  @relation(fields: [accountId], references: [id])

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category         Category[]
}

model Category {
  id               Int      @id @default(autoincrement())

  isUsedInItemName Boolean  @default(false)
  name             String
  shortName        String

  classificationId Int
  classification   Classification @relation(fields: [classificationId], references: [id])

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  group            Group[]
}

model Group {
  id               Int      @id @default(autoincrement())

  isUsedInItemName Boolean  @default(false)
  name             String
  shortName        String

  categoryId       Int
  category         Category @relation(fields: [categoryId], references: [id])

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subGroup         SubGroup[]
}

model SubGroup {
  id               Int      @id @default(autoincrement())

  isUsedInItemName Boolean  @default(false)
  name             String
  shortName        String

  groupId          Int
  group            Group    @relation(fields: [groupId], references: [id])

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model RawMaterial {
  id                   Int      @id @default(autoincrement())

  // 🔹 Basic
  shapeId              Int
  materialId           Int
  itemName             String
  description          String?
  grade                String?
  unitId               Int

  purchaseRate         Float
  sellingRate          Float

  // 🔹 Tax
  hsnId                Int
  hsn                  HsnMaster @relation(fields: [hsnId], references: [id])
  gstSlab              Int

  // 🔹 Other
  type                 String
  scrapItemId          Int?

  allowedExcessQty     Float?
  thickness            Float?
  leadTimeDays         Int?
  minStockQty          Float?
  minOrderQty          Float?

  valuationMethod      String?

  isDimensional        Boolean @default(false)
  isScrap              Boolean @default(false)
  allowNegativeStock   Boolean @default(false)
  inspectionRequired   Boolean @default(false)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Item {
  id                    Int      @id @default(autoincrement())

  // 🔹 Hierarchy
  classificationId      Int
  categoryId            Int
  groupId               Int
  subGroupId            Int?

  // 🔹 Basic
  itemName              String
  description           String?
  grade                 String?
  partDescription       String?

  unitId                Int

  purchaseRate          Float @default(0)
  sellingRate           Float @default(0)

  // 🔹 Tax
  hsnId                 Int
  gstSlab               Int

  // 🔹 Drawing
  drawingNo             String?
  drawingRevision       String?
  customerItemCode      String?

  // 🔹 Manufacturing
  allowedExcessQty      Float?
  thickness             Float?
  length                Float?
  width                 Float?

  netWeight             Float?
  grossWeight           Float?

  weightUomId           Int?
  density               Float?
  densityUomId          Int?

  surfaceArea           Float?
  surfaceAreaUomId      Int?

  // 🔹 Inventory
  rawMaterialItemId     Int?
  scrapItemId           Int?

  leadTimeDays          Int?
  minStockQty           Float?
  minOrderQty           Float?

  valuationMethod       String?

  // 🔹 Flags
  allowNegativeStock    Boolean @default(false)
  inspectionRequired    Boolean @default(false)

  isDimensional         Boolean @default(false)
  isScrap               Boolean @default(false)

  // 🔹 Type
  itemType              String

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  transactions          ItemTransaction[]
}

enum ItemTransactionAction {
  ADD
  UPDATE
  DELETE
}

enum ItemTransactionSource {
  ITEM
  LEAD
  QUOTATION
  SALES_ORDER
  TAX_INVOICE
  PURCHASE_INDENT
}

model ItemTransaction {
  id               Int                    @id @default(autoincrement())

  itemId           Int
  action           ItemTransactionAction
  sourceModule     ItemTransactionSource
  sourceId         Int
  sourceLineItemId Int?

  qty              Float?
  rate             Float?
  unitId           Int?

  item             Item                   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt        DateTime               @default(now())

  @@index([itemId])
  @@index([sourceModule, sourceId])
  @@index([createdAt])
}

model Lead {
  id                 Int      @id @default(autoincrement())

  leadType           String
  leadStatus         String
  leadSource         String
  leadStage          String

  name               String
  company            String?
  position           String?

  gstNo              String?

  email              String?
  contactNo          String?

  website            String?
  industry           String?

  countryId          Int?
  stateId            Int?

  city               String?
  pinCode            String?

  addressLine1       String?
  addressLine2       String?

  regionId           Int?
  zoneId             Int?
  subZoneId          Int?

  assignedEmployeeId Int?

  items              LeadItem[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model LeadItem {
  id          Int    @id @default(autoincrement())

  leadId      Int
  itemId      Int

  description String?
  qty         Float?

  lead        Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

enum QuoteType {
  GOODS
  SERVICE
}

model Quotation {
  id                    Int      @id @default(autoincrement())

  // Header fields
  customerId            Int
  contactPersonId       Int?
  gstNo                 String?
  quoteDate             DateTime
  expiryDate            DateTime
  paymentTermId         Int?
  bankAccountId         Int?
  quoteType             QuoteType

  // Totals
  grossAmount           Float    @default(0)
  cgstAmount            Float    @default(0)
  sgstAmount            Float    @default(0)
  igstAmount            Float    @default(0)
  shippingCharge        Float    @default(0)
  grandTotal            Float    @default(0)

  // Terms & Conditions
  termsAndConditions    String?

  // Relations
  customer              Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contactPerson         CustomerContactPerson? @relation(fields: [contactPersonId], references: [id], onDelete: SetNull)
  paymentTerms          PaymentTerms? @relation(fields: [paymentTermId], references: [id], onDelete: SetNull)
  bankAccount           BankAccounts? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  // Line items
  lineItems             QuotationLineItem[]
  salesOrders           SalesOrder[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([customerId])
  @@index([quoteDate])
}

model QuotationLineItem {
  id                    Int      @id @default(autoincrement())

  quotationId           Int
  itemId                Int

  description           String?
  unitId                Int?
  hsnCode               String?
  qty                   Float    @default(0)
  rate                  Float    @default(0)
  discountPercentage    Float    @default(0)
  discountAmount        Float    @default(0)
  taxableAmount         Float    @default(0)

  cgstRate              Float    @default(0)
  cgstAmount            Float    @default(0)

  sgstRate              Float    @default(0)
  sgstAmount            Float    @default(0)

  lineTotal             Float    @default(0)

  // Relations
  quotation             Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([quotationId])
}

model SalesOrder {
  id                    Int      @id @default(autoincrement())

  customerId            Int
  contactPersonId       Int?
  shippingAddressId     Int?
  shippingAddressText   String?
  gstNo                 String?
  plantUnitId           Int?
  orderDate             DateTime
  poNo                  String?
  poDate                DateTime?
  refQuotationId        Int?
  paymentTermId         Int?
  clientPoDocument      String?

  grossAmount           Float    @default(0)
  cgstAmount            Float    @default(0)
  sgstAmount            Float    @default(0)
  igstAmount            Float    @default(0)
  shippingCharge        Float    @default(0)
  grandTotal            Float    @default(0)

  termsAndConditions    String?

  customer              Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contactPerson         CustomerContactPerson? @relation(fields: [contactPersonId], references: [id], onDelete: SetNull)
  shippingAddress       CustomerAddress? @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  plantUnit             PlantUnit? @relation(fields: [plantUnitId], references: [id], onDelete: SetNull)
  paymentTerms          PaymentTerms? @relation(fields: [paymentTermId], references: [id], onDelete: SetNull)
  quotation             Quotation? @relation(fields: [refQuotationId], references: [id], onDelete: SetNull)

  lineItems             SalesOrderLineItem[]
  taxInvoices           TaxInvoice[]
  purchaseIndents       PurchaseIndent[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([customerId])
  @@index([orderDate])
}

model SalesOrderLineItem {
  id                    Int      @id @default(autoincrement())

  salesOrderId          Int
  itemId                Int

  itemDetails           String?
  description           String?
  poLineNo              String?
  unitId                Int?
  hsnCode               String?
  deliveryDate          DateTime?

  qty                   Float    @default(0)
  rate                  Float    @default(0)
  discountPercentage    Float    @default(0)
  discountAmount        Float    @default(0)
  taxableAmount         Float    @default(0)

  cgstRate              Float    @default(0)
  cgstAmount            Float    @default(0)
  sgstRate              Float    @default(0)
  sgstAmount            Float    @default(0)
  igstRate              Float    @default(0)
  igstAmount            Float    @default(0)

  lineTotal             Float    @default(0)

  salesOrder            SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([salesOrderId])
}

model TaxInvoice {
  id                    Int      @id @default(autoincrement())

  supplyType            String?
  plantUnitId           Int?
  warehouseId           Int?

  customerId            Int
  contactPersonId       Int?
  billingAddressText    String?
  gstNo                 String?
  shippingAddressId     Int?
  shippingAddressText   String?

  invoiceNo             String
  invoiceDate           DateTime
  customerPoNo          String?
  customerPoDate        DateTime?
  refSalesOrderId       Int?
  salesOrderNo          String?
  salesOrderDate        DateTime?
  despatchDocNo         String?
  paymentTermId         Int?
  despatchThrough       String?
  destination           String?
  bankAccountId         Int?
  dueDate               DateTime?

  remarks               String?
  ewayBillDetails       String?

  grossAmount           Float    @default(0)
  cgstAmount            Float    @default(0)
  sgstAmount            Float    @default(0)
  igstAmount            Float    @default(0)
  shippingCharge        Float    @default(0)
  tcsAmount             Float    @default(0)
  roundOff              Float    @default(0)
  roundOffEnabled       Boolean  @default(false)
  grandTotal            Float    @default(0)

  termsAndConditions    String?

  customer              Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contactPerson         CustomerContactPerson? @relation(fields: [contactPersonId], references: [id], onDelete: SetNull)
  shippingAddress       CustomerAddress? @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  plantUnit             PlantUnit? @relation(fields: [plantUnitId], references: [id], onDelete: SetNull)
  warehouse             Warehouses? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  paymentTerms          PaymentTerms? @relation(fields: [paymentTermId], references: [id], onDelete: SetNull)
  bankAccount           BankAccounts? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  salesOrder            SalesOrder? @relation(fields: [refSalesOrderId], references: [id], onDelete: SetNull)

  lineItems             TaxInvoiceLineItem[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([customerId])
  @@index([invoiceDate])
  @@index([invoiceNo])
}

model TaxInvoiceLineItem {
  id                    Int      @id @default(autoincrement())

  taxInvoiceId          Int
  itemId                Int

  itemDetails           String?
  description           String?
  customerItemCode      String?
  unitId                Int?
  hsnCode               String?

  qty                   Float    @default(0)
  rate                  Float    @default(0)
  discountPercentage    Float    @default(0)
  discountAmount        Float    @default(0)
  taxableAmount         Float    @default(0)

  cgstRate              Float    @default(0)
  cgstAmount            Float    @default(0)
  sgstRate              Float    @default(0)
  sgstAmount            Float    @default(0)
  igstRate              Float    @default(0)
  igstAmount            Float    @default(0)

  lineTotal             Float    @default(0)

  refSalesOrderNo       String?
  refJwoinNo            String?
  refChallanNo          String?

  taxInvoice            TaxInvoice @relation(fields: [taxInvoiceId], references: [id], onDelete: Cascade)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([taxInvoiceId])
}

model PurchaseIndent {
  id                    Int      @id @default(autoincrement())

  prApprovalPath        String   @default("Default Path For Indent")
  departmentId          Int?
  refSalesOrderId       Int?
  refProdPlnNo          String?
  indentDate            DateTime
  plantUnitId           Int?
  typeOfPr              String?
  docAttachmentRequired Boolean  @default(false)
  remarks               String?

  department            Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  salesOrder            SalesOrder? @relation(fields: [refSalesOrderId], references: [id], onDelete: SetNull)
  plantUnit             PlantUnit? @relation(fields: [plantUnitId], references: [id], onDelete: SetNull)
  lineItems             PurchaseIndentLineItem[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([indentDate])
  @@index([departmentId])
}

model PurchaseIndentLineItem {
  id                    Int      @id @default(autoincrement())

  purchaseIndentId      Int
  itemId                Int?
  description           String?
  qty                   Float    @default(0)
  unitId                Int?
  requiredDate          DateTime?
  suggestedVendorId     Int?
  details               String?

  purchaseIndent        PurchaseIndent @relation(fields: [purchaseIndentId], references: [id], onDelete: Cascade)
  suggestedVendor       Supplier? @relation(fields: [suggestedVendorId], references: [id], onDelete: SetNull)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([purchaseIndentId])
}